# Copy outside Git; fill privately. No quotes needed unless the value contains spaces.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PICKUP_SHARED_SECRET=
# Replace with an actual absolute path. This parser does NOT expand ~ or $HOME.
PICKUP_MAC_CONFIG=/ABSOLUTE/PATH/TO/nj-iphone-duo-monitor/pickup_bridge.local.json
# Optional ZIP override; current production watches this ZIP's 12 stores.
APPLE_PICKUP_ZIP=07094
# Used by the service installer; always pass --provider dataimpulse as well.
IPHONE_MONITOR_PROVIDER=dataimpulse
